# Copy this file to "keystore.properties" (same folder) and fill in real values - that file
# is what app/build.gradle.kts actually reads, and it's excluded in .gitignore so your
# passwords never end up committed anywhere.
#
# You don't need to fill this in by hand: installer/build-release-apk.ps1 creates both the
# keystore and this file for you the first time you run it.
storeFile=catsoftfon-release.keystore
storePassword=
keyAlias=catsoftfon
keyPassword=
