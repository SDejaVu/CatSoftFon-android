<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/cat_window_bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/incoming_call_title"
        android:textColor="@color/cat_text_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/callerNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/cat_text_primary"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/callerNumberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/cat_text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="48dp">

        <ImageButton
            android:id="@+id/declineButton"
            style="@style/Cat.HangupButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="24dp"
            android:contentDescription="@string/decline_button"
            android:src="@drawable/ic_call_end" />

        <ImageButton
            android:id="@+id/acceptButton"
            style="@style/Cat.CallButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="24dp"
            android:contentDescription="@string/answer_button"
            android:src="@drawable/ic_call" />
    </LinearLayout>

</LinearLayout>
