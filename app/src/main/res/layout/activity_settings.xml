<?xml version="1.0" encoding="utf-8"?>
<!-- Up to 3 independent SIP accounts/lines - one inner tab per account (accountTabs), each
     backed by its own inflated copy of account_fields.xml inside accountFieldsContainer (see
     SettingsActivity.kt). Only account 1 needs to be filled in; 2 and 3 can be left blank to
     use just one line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cat_window_bg">

    <!-- The app has no system action bar (NoActionBar theme, see themes.xml) - without this
         row there was no on-screen way to leave this screen at all except the system back
         gesture/button, which the user reported wasn't obvious/available. Mirrors
         activity_main.xml's own statusBar row (same Cat.Panel style). -->
    <LinearLayout
        style="@style/Cat.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@null"
            android:contentDescription="@string/back_button"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/cat_text_primary"
            android:textStyle="bold"
            android:text="@string/settings_title" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/accountTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cat_panel_bottom"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <FrameLayout
        android:id="@+id/accountFieldsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Asks the OS to stop battery-optimizing this app, so registration/incoming calls keep
         working while it's backgrounded - see SettingsActivity.updateBackgroundButton(). -->
    <Button android:id="@+id/backgroundPermissionButton" style="@style/Cat.Button3D" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/allow_background_button" android:layout_margin="16dp" android:layout_marginBottom="4dp" />

    <!-- Android 14+ defaults the "use full-screen intent" permission to off for every app
         except the default dialer - without it granted, the incoming-call screen may not pop
         up on its own. See SettingsActivity.updateFullScreenIntentButtonState(). -->
    <Button android:id="@+id/fullScreenIntentButton" style="@style/Cat.Button3D" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/full_screen_intent_button" android:layout_margin="16dp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp" />

    <Button android:id="@+id/audioSettingsButton" style="@style/Cat.Button3D" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_settings_title" android:layout_margin="16dp" android:layout_marginTop="0dp" android:layout_marginBottom="4dp" />

    <!-- "Исходный код" and the presence-diagnostics share button were removed from this screen
         at the user's request (Nov 2026) - see SettingsActivity.kt and AppInfo.kt for the
         AGPLv3 note: linphone-sdk-android is AGPLv3, so this app's source must still be
         reachable somehow (e.g. a link in the Play/RuStore listing) even without this button. -->

    <Button android:id="@+id/saveSettingsButton" style="@style/Cat.ButtonAccentRect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" android:layout_margin="16dp" android:layout_marginTop="8dp" />

</LinearLayout>
