<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cat_window_bg">

    <!-- Slim global header: just the app name and the settings shortcut. Per-line
         registration status now lives on each line's own tab below (lineTabs), since there
         are up to 3 independent SIP accounts/lines rather than one. -->
    <LinearLayout
        android:id="@+id/statusBar"
        style="@style/Cat.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cat_text_primary"
            android:textStyle="bold"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@null"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- One tab per line (up to SipManager.LINE_COUNT) - each tab's custom view (tab_line.xml)
         shows that line's own registration dot + label. Selecting a tab just changes which
         line the current Звонок/Контакты/История fragment (bottomNav below) operates on. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/lineTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cat_panel_bottom"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cat_panel_bottom"
        app:itemIconTint="@color/cat_text_primary"
        app:itemTextColor="@color/cat_text_primary"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
