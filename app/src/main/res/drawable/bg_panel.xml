<?xml version="1.0" encoding="utf-8"?>
<!-- Raised panel background - same "glossy gradient + thin edge" language as the Windows
     client's PanelBrush/Edge3DBrush. Used behind toolbars, cards and list rows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/cat_panel_top"
        android:endColor="@color/cat_panel_bottom" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/cat_edge" />
</shape>
