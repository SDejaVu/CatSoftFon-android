<?xml version="1.0" encoding="utf-8"?>
<!-- Sunken/carved look for text fields, mirroring the Windows client's
     FieldSunkenBackgroundBrush/FieldSunkenBorderBrush. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/cat_sunken_bg" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="@color/cat_edge" />
    <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp" />
</shape>
